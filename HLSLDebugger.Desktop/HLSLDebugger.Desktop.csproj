<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22000.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="RenamePublishedExe" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)HLSLDebugger.Desktop.exe" DestinationFiles="$(PublishDir)HLSLDebugger.exe" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BlazorDesktop" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HLSLDebugger\HLSLDebugger.csproj" />
  </ItemGroup>

</Project>
